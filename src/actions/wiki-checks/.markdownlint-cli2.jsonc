// markdownlint for a wiki (used by src/actions/wiki-checks): the sllmwiki
// repository's rules, which catch only markdown that renders wrong.
{
  "config": {
    "extends": "../../../.markdownlint.jsonc"
  },
  // sources are verbatim copies, never edited; templates/ holds the wiki's own
  // narrative templates, full of <placeholder> text (narrative-format checks them)
  "ignores": ["sllmwiki/sources/**", "templates/**", "**/node_modules/**"]
}
